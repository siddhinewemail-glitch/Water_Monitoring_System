# Copy to .env and fill in.
SUPABASE_URL=https://croppaplncboxqdcnlbu.supabase.co
# Secret key (Dashboard -> Project Settings -> API Keys -> Secret keys).
# Server-side only: it bypasses Row Level Security. Never ship it to the browser or ESP32.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Protects POST /api/model/train and /api/score
ADMIN_TOKEN=change-me

# How often the background worker scores new readings (seconds)
SCORE_INTERVAL_SECONDS=30
# Minimum clean readings before training on real data (otherwise synthetic bootstrap)
MIN_TRAIN_ROWS=500
# Comma-separated origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173
